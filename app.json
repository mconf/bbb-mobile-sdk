{
  "expo": {
    "name": "bbbmobile",
    "slug": "bbbmobile",
    "owner": "mconf",
    "scheme": [
      "bigbluebutton",
      "org.bbb.mobilesdk"
    ],
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/native/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06172A",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enableBsdiffPatchSupport": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bitcode": false,
      "bundleIdentifier": "org.bbb.mobilesdk",
      "appleTeamId": "GN7LTX8MS8",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "voip"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/native/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "org.bbb.mobilesdk"
    },
    "plugins": [
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/native/splash.png",
          "backgroundColor": "#06172A",
          "resizeMode": "contain",
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "mediaPlayback",
                "microphone"
              ]
            }
          }
        }
      ]
    ],
    "web": {
      "favicon": "./src/assets/native/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "144b9892-f6ac-4cac-a334-27c560457569"
      }
    }
  }
}
